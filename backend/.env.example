# Copiá este archivo como .env y completá los valores. El .env no se sube a GitHub.

# Puerto donde escucha la API
PORT=3000

# Origen(es) del frontend permitidos por CORS, separados por coma
CORS_ORIGIN=http://localhost:5173

# Firma de las sesiones. En producción es obligatoria y tiene que ser larga y aleatoria.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Usuario administrador que se crea al arrancar. La contraseña es obligatoria en producción.
ADMIN_EMAIL=admin@churroberto.com
ADMIN_PASSWORD=

# Solo si la API corre detrás de un proxy (por ejemplo, un hosting): cantidad de saltos de confianza
# TRUST_PROXY=1
